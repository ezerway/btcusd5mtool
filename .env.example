# Polymarket BTC 5M Bot Configuration

# Trading Mode: 'dry-run' (Paper Trading) or 'live' (Real Wallet Trading via Playwright)
MODE=dry-run

# Bet Amount per trade in USDC
BET_AMOUNT_USDC=5.0

# Maximum bet clicks allowed per 5m window (e.g. 1, 2, 3, etc.)
MAX_BETS_PER_WINDOW=1

# Delay in milliseconds between consecutive bet clicks in the same window (cooldown)
BET_COOLDOWN_MS=2500

# Max Bet Limit (Safety Cap)
MAX_BET_USDC=20.0

# Stop loss limit in USDC (Bot halts if daily paper/live loss reaches this limit)
MAX_DAILY_LOSS_USDC=50.0

# Stop bot betting when account balance reaches or drops below this USDC amount (0 to disable)
STOP_AT_BALANCE=50.0

# Stop-Loss / Cash Out trigger percentage drop from entry price (e.g. 20.0 for 20% drop)
CASHOUT_DROP_PERCENT=20.0

# Initial paper trading virtual balance
INITIAL_PAPER_BALANCE=100.0

# Playwright Browser Options
HEADLESS=false
USER_DATA_DIR=./user_data

MIN_SECONDS_BEFORE_EXPIRY=25
MAX_SECONDS_BEFORE_EXPIRY=240
PRICE_DELTA_THRESHOLD_USD=10.0
MIN_CONFIDENCE=0.65

# SQLite Performance & Data Retention (for 24/7 continuous running)
TICKS_RETENTION_HOURS=24
LOST_SCANS_RETENTION_DAYS=14
