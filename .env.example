# Polymarket BTC 5M Bot Configuration

# Trading Mode: 'dry-run' (Paper Trading) or 'live' (Real Wallet Trading via Playwright)
MODE=dry-run

# Bet Amount per trade in USDC
BET_AMOUNT_USDC=5.0

# Max Bet Limit (Safety Cap)
MAX_BET_USDC=20.0

# Stop loss limit in USDC (Bot halts if daily paper/live loss reaches this limit)
MAX_DAILY_LOSS_USDC=50.0

# Initial paper trading virtual balance
INITIAL_PAPER_BALANCE=100.0

# Playwright Browser Options
HEADLESS=false
USER_DATA_DIR=./user_data

# Strategy Parameters
MIN_SECONDS_BEFORE_EXPIRY=25
MAX_SECONDS_BEFORE_EXPIRY=240
PRICE_DELTA_THRESHOLD_USD=10.0
MIN_CONFIDENCE=0.65
